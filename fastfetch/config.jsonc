{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        },
        "color": {
            "1": "magenta",
            "2": "cyan"
        }
    },
    "display": {
        "separator": "  󰅂  ",
        "color": {
            "keys": "magenta",
            "title": "magenta"
        }
    },
    "modules": [
        "title",
        {
            "type": "custom",
            "format": "──────────────────────────────────────────────"
        },
        {
            "type": "os",
            "key": "󰻀 OS        ",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": "󰌽 Kernel    ",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime    ",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": "󰨇 WM        ",
            "keyColor": "green"
        },
        {
            "type": "terminal",
            "key": "󰆍 Terminal  ",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": "󰞷 Shell     ",
            "keyColor": "magenta"
        },
        {
            "type": "cpu",
            "key": "󰍛 CPU       ",
            "keyColor": "red"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU       ",
            "keyColor": "yellow"
        },
        {
            "type": "memory",
            "key": "󰘚 Memory    ",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "──────────────────────────────────────────────"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
