# Dracula theme for btop

# Main background, should be in hex format
theme[main_bg]="#282a36"

# Main text color
theme[main_fg]="#f8f8f2"

# Title text color
theme[title]="#f8f8f2"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#bd93f9"

# Background color of selected item in lists
theme[selected_bg]="#44475a"

# Foreground color of selected item in lists
theme[selected_fg]="#ff79c6"

# Color of inactive/disabled text
theme[inactive_fg]="#6272a4"

# Color of text appearing on top of graphs, i.e. uptime etc.
theme[graph_text]="#f8f8f2"

# Background color of percentage bars
theme[meter_bg]="#44475a"

# Misc colors for processes box including mini cpu graph, process list frame and scrollbar
theme[proc_misc]="#bd93f9"

# Cpu box outline color
theme[cpu_box]="#bd93f9"

# Memory box outline color
theme[mem_box]="#ff79c6"

# Net box outline color
theme[net_box]="#50fa7b"

# Processes box outline color
theme[proc_box]="#8be9fd"

# Box divider line color
theme[div_line]="#44475a"

# Temperature graph colors
theme[temp_start]="#50fa7b"
theme[temp_mid]="#f1fa8c"
theme[temp_end]="#ff5555"

# CPU graph colors
theme[cpu_start]="#bd93f9"
theme[cpu_mid]="#ff79c6"
theme[cpu_end]="#ff5555"

# Mem/Disk free meter
theme[free_start]="#50fa7b"
theme[free_mid]="#f1fa8c"
theme[free_end]="#ffb86c"

# Mem/Disk cached meter
theme[cached_start]="#8be9fd"
theme[cached_mid]="#bd93f9"
theme[cached_end]="#ff79c6"

# Mem/Disk available meter
theme[available_start]="#f1fa8c"
theme[available_mid]="#ffb86c"
theme[available_end]="#ff5555"

# Mem/Disk used meter
theme[used_start]="#ff79c6"
theme[used_mid]="#bd93f9"
theme[used_end]="#ff5555"

# Download graph colors
theme[download_start]="#bd93f9"
theme[download_mid]="#8be9fd"
theme[download_end]="#50fa7b"

# Upload graph colors
theme[upload_start]="#ff79c6"
theme[upload_mid]="#ffb86c"
theme[upload_end]="#f1fa8c"

# Process box color gradient for Process tree
theme[process_start]="#8be9fd"
theme[process_mid]="#bd93f9"
theme[process_end]="#ff79c6"