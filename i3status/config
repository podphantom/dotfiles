# i3status configuration file
# Location: ~/.config/i3status/config

general {
    colors = true
    color_good = "#a6e3a1"
    color_degraded = "#f9e2af"
    color_bad = "#f38ba8"
    interval = 2
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "disk /"
order += "cpu_usage"
order += "memory"
order += "tztime local"

wireless _first_ {
    format_up = "󰤨 %quality (%essid)"
    format_down = "󰤭 down"
}

ethernet _first_ {
    format_up = "󰈀 %speed"
    format_down = "󰈀 down"
}

battery all {
    format = "%status %percentage %remaining"
    format_down = "No battery"
    status_chr = "⚡"
    status_bat = "🔋"
    status_unk = "?"
    status_full = "☻"
    path = "/sys/class/power_supply/BAT%d/uevent"
    low_threshold = 10
}

disk "/" {
    format = "󰋊 %avail"
}

cpu_usage {
    format = " %usage"
}

memory {
    format = "󰍛 %used"
    threshold_degraded = "1G"
    format_degraded = "MEMORY < %threshold"
}

tztime local {
    format = "󰃭 %Y-%m-%d  󱑌 %H:%M:%S"
}
